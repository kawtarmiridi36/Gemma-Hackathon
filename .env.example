# ============================================================
# Dar Al Oumouma AI - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=sqlite:///./app/dar_al_oumouma.db

# NVIDIA API (for Gemma, Vista-3D)
NVIDIA_API_KEY=

# ML Models
GEMMA_MODEL=google/gemma-4-31b-it
VISTA3D_MODEL=nvidia/vista-3d
WHISPER_MODEL=medium
USE_LOCAL_MODEL=false

# ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
